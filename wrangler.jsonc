// Configurazione per Cloudflare (Workers con file statici): pubblica il sito così com'è, senza build.
{
  "name": "salagiochionline",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
