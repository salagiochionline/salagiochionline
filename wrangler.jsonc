// Configurazione per Cloudflare (Workers con file statici).
// - Le pagine del sito sono servite così come sono, senza build.
// - server/worker.js risponde solo su /mqtt: è il server multiplayer di Tavolata
//   (un Durable Object "Broker", compreso nel piano gratuito).
{
  "name": "salagiochionline",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mqtt", "/mqtt/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BROKER", "class_name": "Broker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Broker"] }]
}
